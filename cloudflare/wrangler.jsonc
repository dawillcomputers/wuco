{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wuco-api",
  "account_id": "1d297e4b2acf7da2607af4472cf9bcf2",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "observability": {
    "enabled": true
  },
  // Hourly housekeeping: half-finished event registrations become named leads
  // rather than sitting in the pending queue, and analytics rows past the
  // retention window are removed. Nothing is deleted that the academy needs.
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://wuco.pages.dev",
    // Account created by the one-time /api/auth/bootstrap call.
    "SUPERADMIN_EMAIL": "proptgoservices@gmail.com",

    // ---------------------------------------------------------------------
    // PAYMENTS run on Flutterwave v3 Standard — the hosted checkout.
    //
    // There is nothing to configure here any more. Whether the academy is
    // charging real cards is decided by which secret key is set:
    //
    //   FLWSECK_TEST-…   test account, no money moves
    //   FLWSECK-…        live account, real cards
    //
    // Set it with:  npx wrangler secret put FLW_SECRET_KEY
    // And the webhook hash from the dashboard:
    //                npx wrangler secret put FLW_SECRET_HASH
    //
    // Deliberately not a var: unlike an environment name, the key is a
    // credential. The environment is still reviewable — it is legible from the
    // key's own prefix — without the key itself being in version control.
    //
    // The V4 settings below are unused by the payment path and kept only
    // because the account still holds those credentials.
    // ---------------------------------------------------------------------
    // The v3 public key. Public by design — it is handed to the browser to
    // open Flutterwave's checkout — so it lives here where it can be reviewed
    // rather than in `wrangler secret`.
    //
    // LIVE KEY. `FLWPUBK-` with no `_TEST` means real cards and real money.
    // The test equivalent is prefixed `FLWPUBK_TEST-`.
    //
    // It cannot take a payment on its own: a public key can start a checkout
    // but cannot confirm one, and WEA only marks something paid after asking
    // Flutterwave directly with the secret key.
    "FLW_PUBLIC_KEY": "FLWPUBK-535cca6298e7fbb4e9841b9c3778cdfd-X",

    "FLW_ENVIRONMENT": "PRODUCTION",
    "FLW_V4_BASE_URL": "https://f4bexperience.flutterwave.com",

    // ---------------------------------------------------------------------
    // YOUTUBE
    //
    // Where Google sends the owner back after they authorise WUCO. Not a
    // secret — it travels in the browser's address bar — so it lives here
    // where it can be reviewed rather than in `wrangler secret`.
    //
    // Google compares this against the client's authorised redirect list as a
    // literal string: scheme, host, path and any trailing slash must match
    // exactly, or the consent screen refuses with redirect_uri_mismatch.
    //
    // This must be registered, character for character, as an Authorised
    // redirect URI on the Google OAuth client. Authorised JavaScript origins
    // stays empty: this is the server-side authorization-code flow, and no
    // browser script ever calls Google.
    // ---------------------------------------------------------------------
    "GOOGLE_REDIRECT_URI": "https://wuco-api.dawillcomputers.workers.dev/api/auth/youtube/callback",
    // Public by design — it appears in the consent URL in the user's own
    // address bar — so it lives here where it can be reviewed rather than in
    // `wrangler secret`. Only the client secret is hidden.
    //
    // One Google client does both jobs here: it signs people in, and it acts
    // on the academy's YouTube channel. That works because this client has
    // https://wuco.pages.dev among its authorised JavaScript origins (which
    // sign-in needs, from the browser) *and* the Worker's callback among its
    // authorised redirect URIs (which YouTube needs, server-side).
    //
    // To separate them later, set YOUTUBE_CLIENT_ID and YOUTUBE_CLIENT_SECRET
    // to the channel client; they take precedence and leave sign-in on this one.
    "GOOGLE_CLIENT_ID": "513554804350-g624hsfnc6q48305enf9haesuvqmquq9.apps.googleusercontent.com"
  },
  // BOOTSTRAP_TOKEN is a secret, not a var. Set it with:
  //   npx wrangler secret put BOOTSTRAP_TOKEN
  // It guards the one-time Super Admin bootstrap endpoint.
  "d1_databases": [
    {
      "binding": "WEA_DB",
      "database_name": "wuco-production",
      "database_id": "892c42de-fe7d-424f-9146-d127315b4796",
      "migrations_dir": "migrations"
    }
  ],
  // Credentials and short-lived state that must never sit in D1: the YouTube
  // refresh token, the cached access token, and single-use OAuth states.
  //
  "kv_namespaces": [
    {
      "binding": "WUCO_TOKENS",
      "id": "59a4c235fa1d4fdabdec450f8c83521a",
      "preview_id": "2c1cd45bed4c4c4c845115ebdfb2b1d4"
    }
  ],
  // Programme, area and faculty imagery uploaded through the Super Admin CMS.
  // The bucket stays private; assets are served through GET /api/media/:key so
  // no public bucket domain has to be configured. The deploy workflow creates
  // it if it does not exist.
  "r2_buckets": [
    {
      "binding": "WEA_MEDIA",
      "bucket_name": "wuco-media"
    }
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wuco-api",
  "account_id": "1d297e4b2acf7da2607af4472cf9bcf2",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "observability": {
    "enabled": true
  },
  // Hourly housekeeping: half-finished event registrations become named leads
  // rather than sitting in the pending queue, and analytics rows past the
  // retention window are removed. Nothing is deleted that the academy needs.
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://wuco.pages.dev",
    // Account created by the one-time /api/auth/bootstrap call.
    "SUPERADMIN_EMAIL": "proptgoservices@gmail.com",

    // ---------------------------------------------------------------------
    // PAYMENTS ARE LIVE. Every payment taken through this deployment charges
    // a real card and moves real money.
    //
    // To return to testing, set FLW_ENVIRONMENT to SANDBOX and remove
    // FLW_V4_BASE_URL — the sandbox host is known and applied automatically.
    //
    // Neither of these is a secret, so they live here rather than in
    // `wrangler secret`: what environment the academy is charging in should be
    // reviewable in version control, not hidden. The credentials themselves
    // remain secrets.
    // ---------------------------------------------------------------------
    "FLW_ENVIRONMENT": "PRODUCTION",
    "FLW_V4_BASE_URL": "https://f4bexperience.flutterwave.com",

    // ---------------------------------------------------------------------
    // YOUTUBE
    //
    // Where Google sends the owner back after they authorise WUCO. Not a
    // secret — it travels in the browser's address bar — so it lives here
    // where it can be reviewed rather than in `wrangler secret`.
    //
    // Google compares this against the client's authorised redirect list as a
    // literal string: scheme, host, path and any trailing slash must match
    // exactly, or the consent screen refuses with redirect_uri_mismatch.
    //
    // This must be registered, character for character, as an Authorised
    // redirect URI on the Google OAuth client. Authorised JavaScript origins
    // stays empty: this is the server-side authorization-code flow, and no
    // browser script ever calls Google.
    // ---------------------------------------------------------------------
    "GOOGLE_REDIRECT_URI": "https://wuco-api.dawillcomputers.workers.dev/api/auth/youtube/callback"
  },
  // BOOTSTRAP_TOKEN is a secret, not a var. Set it with:
  //   npx wrangler secret put BOOTSTRAP_TOKEN
  // It guards the one-time Super Admin bootstrap endpoint.
  "d1_databases": [
    {
      "binding": "WEA_DB",
      "database_name": "wuco-production",
      "database_id": "892c42de-fe7d-424f-9146-d127315b4796",
      "migrations_dir": "migrations"
    }
  ],
  // Credentials and short-lived state that must never sit in D1: the YouTube
  // refresh token, the cached access token, and single-use OAuth states.
  //
  "kv_namespaces": [
    {
      "binding": "WUCO_TOKENS",
      "id": "59a4c235fa1d4fdabdec450f8c83521a",
      "preview_id": "2c1cd45bed4c4c4c845115ebdfb2b1d4"
    }
  ],
  // Programme, area and faculty imagery uploaded through the Super Admin CMS.
  // The bucket stays private; assets are served through GET /api/media/:key so
  // no public bucket domain has to be configured. The deploy workflow creates
  // it if it does not exist.
  "r2_buckets": [
    {
      "binding": "WEA_MEDIA",
      "bucket_name": "wuco-media"
    }
  ]
}

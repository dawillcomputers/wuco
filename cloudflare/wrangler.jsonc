{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wuco-api",
  "account_id": "1d297e4b2acf7da2607af4472cf9bcf2",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "observability": {
    "enabled": true
  },
  // Hourly housekeeping: half-finished event registrations become named leads
  // rather than sitting in the pending queue, and analytics rows past the
  // retention window are removed. Nothing is deleted that the academy needs.
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://wuco.pages.dev",
    // Account created by the one-time /api/auth/bootstrap call.
    "SUPERADMIN_EMAIL": "proptgoservices@gmail.com"
  },
  // BOOTSTRAP_TOKEN is a secret, not a var. Set it with:
  //   npx wrangler secret put BOOTSTRAP_TOKEN
  // It guards the one-time Super Admin bootstrap endpoint.
  "d1_databases": [
    {
      "binding": "WEA_DB",
      "database_name": "wuco-production",
      "database_id": "892c42de-fe7d-424f-9146-d127315b4796",
      "migrations_dir": "migrations"
    }
  ],
  // Programme, area and faculty imagery uploaded through the Super Admin CMS.
  // The bucket stays private; assets are served through GET /api/media/:key so
  // no public bucket domain has to be configured. The deploy workflow creates
  // it if it does not exist.
  "r2_buckets": [
    {
      "binding": "WEA_MEDIA",
      "bucket_name": "wuco-media"
    }
  ]
}
